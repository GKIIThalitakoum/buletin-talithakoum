---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;

const navItems = [
  {
    href: "/",
    label: "Beranda",
    match: (p: string) => p === "/",
    icon: `<path d="M3 11.5 12 4l9 7.5" /><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" />`,
  },
  {
    href: "/jadwal",
    label: "Jadwal",
    match: (p: string) => p.startsWith("/jadwal"),
    icon: `<rect x="3.5" y="5" width="17" height="16" rx="2" /><path d="M3.5 9.5h17" /><path d="M8 3v4M16 3v4" />`,
  },
  {
    href: "/ibadah",
    label: "Ibadah",
    match: (p: string) => p.startsWith("/ibadah"),
    icon: `<path d="M12 3v18M7 8h10M5 21h14" /><path d="M9 12h6v9H9z" />`,
  },
  {
    href: "/keuangan",
    label: "Keuangan",
    match: (p: string) => p.startsWith("/keuangan"),
    icon: `<rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3 10h18" /><circle cx="7" cy="14.5" r="1" />`,
  },
  {
    href: "/arsip",
    label: "Arsip",
    match: (p: string) => p.startsWith("/arsip"),
    icon: `<rect x="3.5" y="4" width="17" height="5" rx="1" /><path d="M4.5 9v9a1.5 1.5 0 0 0 1.5 1.5h12A1.5 1.5 0 0 0 19.5 18V9" /><path d="M10 13h4" />`,
  },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · GKII Talitha Koum Sendawar</title>
    <meta name="description" content="Buletin mingguan digital GKII Jemaat Talitha Koum Sendawar" />
    <meta name="theme-color" content="#0f1f3d" />
  </head>
  <body class="font-sans text-navy-950 min-h-screen">
    <main class="max-w-md mx-auto min-h-screen bg-cream-50">
      <slot />
    </main>

    <nav
      class="fixed bottom-0 left-0 right-0 bg-white border-t border-cream-200 z-50"
      style="padding-bottom: env(safe-area-inset-bottom);"
      aria-label="Navigasi utama"
    >
      <div class="max-w-md mx-auto grid grid-cols-5">
        {
          navItems.map((item) => {
            const active = item.match(path);
            return (
              
                href={item.href}
                class={`flex flex-col items-center justify-center gap-1 py-2.5 text-xs font-medium ${
                  active ? "text-navy-900" : "text-navy-800/40"
                }`}
                aria-current={active ? "page" : undefined}
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width={active ? "2.2" : "1.6"}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={item.icon}
                />
                {item.label}
              </a>
            );
          })
        }
      </div>
    </nav>
  </body>
</html>
