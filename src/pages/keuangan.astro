---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Laporan Keuangan">
  <div id="app">
    <div class="bg-navy-950 px-5 pt-6 pb-5 rounded-b-3xl">
      <h1 class="font-serif text-white text-xl font-medium">Laporan Keuangan</h1>
      <p id="subheader" class="text-cream-100 text-sm mt-1">&nbsp;</p>
    </div>
    <div class="p-4 space-y-3">
      <div class="skeleton h-24 rounded-2xl"></div>
      <div class="skeleton h-24 rounded-2xl"></div>
      <div class="skeleton h-24 rounded-2xl"></div>
    </div>
  </div>
</Layout>

<script>
  import { getEdisi, getKeuanganKumulatif, getKeuanganDetailByMinggu, formatRupiah } from "../lib/sheets.js";

  function escapeHtml(str: string) {
    const div = document.createElement("div");
    div.textContent = str ?? "";
    return div.innerHTML;
  }

  async function render() {
    const subheader = document.getElementById("subheader")!;
    const list = document.querySelector("#app > div:last-child")!;

    try {
      const edisi = await getEdisi();
      if (!edisi) throw new Error('Tidak ada edisi berstatus "published".');
      subheader.textContent = `Minggu Ke-${edisi.minggu_ke}`;

      const kategoris = await getKeuanganKumulatif();

      if (kategoris.length === 0) {
        list.innerHTML = `<p class="text-center text-navy-800/60 text-sm py-8">Belum ada data di tab Keuangan.</p>`;
        return;
      }

      list.innerHTML = kategoris
        .map(
          (k, idx) => `
        <details class="bg-white rounded-2xl border border-cream-200 overflow-hidden" data-kategori="${escapeHtml(k.nama)}">
          <summary class="p-4 cursor-pointer list-none flex items-start justify-between">
            <div>
              <p class="text-xs font-semibold tracking-wide text-navy-800/60 uppercase mb-1">${escapeHtml(k.nama)}</p>
              <p class="font-serif text-2xl font-semibold text-navy-950">${formatRupiah(k.saldo)}</p>
              <p class="text-xs text-navy-800/50 mt-0.5">Saldo Akhir Minggu Ini</p>
            </div>
            <span class="text-navy-800/40 text-xl leading-none mt-1">+</span>
          </summary>
          <div class="border-t border-cream-200 px-4 pb-4 pt-2 detail-slot text-sm text-navy-800/60">Memuat rincian&hellip;</div>
        </details>`
        )
        .join("");

      list.querySelectorAll("details").forEach((el) => {
        el.addEventListener(
          "toggle",
          async function (this: HTMLDetailsElement) {
            if (!this.open) return;
            const kategori = this.dataset.kategori!;
            const slot = this.querySelector(".detail-slot")!;
            const rows = await getKeuanganDetailByMinggu(kategori, edisi.minggu_ke);

            if (rows.length === 0) {
              slot.innerHTML = `<p>Tidak ada transaksi minggu ini untuk kategori ini.</p>`;
              return;
            }

            slot.innerHTML = rows
              .map(
                (r) => `
              <div class="flex items-center justify-between py-2 border-b border-cream-100 last:border-0">
                <span class="text-navy-800/80 pr-3">${escapeHtml(r.keterangan)}</span>
                <span class="font-medium ${Number(r.debet) > 0 ? "text-navy-900" : "text-navy-800/50"} flex-shrink-0">
                  ${Number(r.debet) > 0 ? "+" + formatRupiah(r.debet) : "-" + formatRupiah(r.kredit)}
                </span>
              </div>`
              )
              .join("");
          },
          { once: true }
        );
      });
    } catch (err) {
      list.innerHTML = `<p class="text-center text-navy-800/70 text-sm py-8">${escapeHtml(err instanceof Error ? err.message : String(err))}</p>`;
    }
  }

  render();
</script>
