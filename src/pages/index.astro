---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Beranda">
  <div id="app" class="pb-6">
    <div class="skeleton h-32 rounded-b-3xl"></div>
    <div class="p-4 space-y-4">
      <div class="skeleton h-28 rounded-2xl"></div>
      <div class="skeleton h-32 rounded-2xl"></div>
    </div>
  </div>
</Layout>

<script>
  import { getEdisi, formatTanggalIndo } from "../lib/sheets.js";
  import { NAMA_GEREJA } from "../lib/config.js";

  const app = document.getElementById("app")!;
  const params = new URLSearchParams(window.location.search);
  const mingguParam = params.get("minggu");

  function escapeHtml(str: string) {
    const div = document.createElement("div");
    div.textContent = str ?? "";
    return div.innerHTML;
  }

  async function render() {
    try {
      const edisi = await getEdisi(mingguParam);

      if (!edisi) {
        app.innerHTML = `
          <div class="p-6 text-center text-navy-800/70">
            <p class="font-serif text-lg mb-1">Edisi tidak ditemukan</p>
            <p class="text-sm">Belum ada edisi berstatus "published" di sheet Edisi.</p>
          </div>`;
        return;
      }

      const isArchive = Boolean(mingguParam);
      const shareText = encodeURIComponent(
        `Buletin ${NAMA_GEREJA} — Minggu Ke-${edisi.minggu_ke} (${edisi.tanggal}). Tema khotbah: ${edisi.tema_khotbah}. Baca selengkapnya: ${window.location.origin}`
      );

      app.innerHTML = `
        <header class="bg-navy-950 text-cream-50 rounded-b-3xl px-5 pt-6 pb-5">
          ${
            isArchive
              ? `<a href="/" class="inline-block text-xs text-gold-400 mb-2">&larr; Kembali ke edisi terbaru</a>`
              : ""
          }
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-gold-500 flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0f1f3d" stroke-width="2.5" stroke-linecap="round"><path d="M12 3v18M6 8h12"/></svg>
            </div>
            <h1 class="font-serif text-lg font-medium leading-snug">${escapeHtml(NAMA_GEREJA)}</h1>
          </div>
          <div class="flex items-center justify-between">
            <span class="bg-gold-500 text-navy-950 text-sm font-medium px-3 py-1 rounded-full">Minggu Ke-${escapeHtml(String(edisi.minggu_ke))}</span>
            <span class="text-sm text-cream-100">${escapeHtml(formatTanggalIndo(edisi.tanggal))}</span>
          </div>
        </header>

        <div class="px-4 pt-4 space-y-4">
          <section class="bg-white rounded-2xl p-5 border border-cream-200">
            <p class="text-xs font-semibold tracking-wide text-navy-800/60 uppercase mb-1">Tema Tahun 2026</p>
            <h2 class="font-serif text-2xl font-semibold text-navy-950 mb-3">Hidup Berdampak</h2>
            <div class="border-t border-cream-200 pt-3">
              <p class="font-serif italic text-navy-800/80 text-sm">Hidup Berarti Bekerja Memberi Buah &ndash; Filipi 1:22</p>
            </div>
          </section>

          <section class="bg-white rounded-2xl p-5 border border-cream-200">
            <p class="text-xs font-semibold tracking-wide text-navy-800/60 uppercase mb-2">Khotbah Minggu Ini</p>
            <span class="inline-block bg-cream-100 text-navy-900 text-sm font-medium px-3 py-1 rounded-lg mb-3">${escapeHtml(edisi.nats || "-")}</span>
            <h3 class="font-serif text-xl font-semibold text-navy-950 mb-1">${escapeHtml(edisi.tema_khotbah || "-")}</h3>
            ${edisi.preposisi ? `<p class="text-sm text-navy-800/70 mb-2">${escapeHtml(edisi.preposisi)}</p>` : ""}
          </section>

          <a href="https://wa.me/?text=${shareText}"
            target="_blank"
            rel="noopener"
            class="flex items-center justify-center gap-2 bg-[#25D366] text-white font-medium py-3.5 rounded-2xl"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.1.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.5-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.4.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.3-.4.1-.2 0-.3 0-.5s-.6-1.5-.9-2.1c-.2-.5-.5-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2.1 3.2 5 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.3c1.5.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.1l-.3-.2-3.2.8.8-3.1-.2-.3c-.8-1.3-1.2-2.8-1.2-4.3 0-4.6 3.7-8.3 8.3-8.3s8.3 3.7 8.3 8.3-3.6 8.2-8.2 8.2z"/></svg>
            Bagikan ke WhatsApp
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a href="/jadwal" class="bg-white border border-cream-200 rounded-2xl py-5 text-center font-medium text-navy-900">Jadwal</a>
            <a href="/ibadah" class="bg-white border border-cream-200 rounded-2xl py-5 text-center font-medium text-navy-900">Ibadah</a>
            <a href="/keuangan" class="bg-white border border-cream-200 rounded-2xl py-5 text-center font-medium text-navy-900">Keuangan</a>
            <a href="/arsip" class="bg-white border border-cream-200 rounded-2xl py-5 text-center font-medium text-navy-900">Arsip</a>
          </div>
        </div>
      `;
    } catch (err) {
      app.innerHTML = `
        <div class="p-6 text-center text-navy-800/70">
          <p class="font-serif text-lg mb-1">Gagal memuat data</p>
          <p class="text-sm">${escapeHtml(err instanceof Error ? err.message : String(err))}</p>
        </div>`;
    }
  }

  render();
</script>
